---
const { title, description } = Astro.props;

// Knownwise fix schema.organization_missing: Organization JSON-LD pins the
// official name, site and logo so AI answer engines don't have to guess.
// The repo defines no social profile URLs, so sameAs is omitted rather than
// invented; all values come from the site's own copy and config.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Larchsend",
  url: Astro.site?.href,
  logo: Astro.site ? new URL("/favicon.svg", Astro.site).href : undefined,
  description:
    "Email marketing for small businesses: newsletters, automations and signup forms.",
};
// "<" must be escaped so a "</script>" in the payload can't end the block early.
const organizationJsonLd = JSON.stringify(organizationSchema).replace(/</g, "\\u003c");
---
<!-- Knownwise fix a11y.lang_missing: declared language stops models and
     screen readers from processing the text with wrong defaults. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" />
    <script type="application/ld+json" set:html={organizationJsonLd} />
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; color: #14110e; background: #faf8f4; line-height: 1.6; }
      header, main, footer { max-width: 920px; margin: 0 auto; padding: 24px; }
      nav a { margin-right: 18px; color: #2f5d50; text-decoration: none; font-weight: 600; }
      .hero { padding: 56px 0 24px; }
      .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
      .plan { border: 1px solid #e6dfd6; border-radius: 12px; padding: 20px; background: #fff; }
      img { max-width: 100%; border-radius: 12px; }
    </style>
  </head>
  <body>
    <header>
      <nav><a href="/">Larchsend</a><a href="/pricing">Pricing</a><a href="/blog">Blog</a></nav>
    </header>
    <main><slot /></main>
    <footer>© 2026 Larchsend · Email marketing for small businesses</footer>
  </body>
</html>
