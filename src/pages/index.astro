---
import Base from "../layouts/Base.astro";

// Knownwise fix meta.title_length: 20-70 chars, topic front-loaded; the
// title is the strongest grounding signal for what a page is about.
const title =
  "Email Marketing Software for Small Businesses — Larchsend";
const description =
  "Larchsend is email marketing for small businesses: newsletters, automations and signup forms that small teams set up in an afternoon.";

// Knownwise fix schema.page_type_missing: page-type schema tells models what
// kind of thing this page is. The home page sells a software product, so the
// honest type is SoftwareApplication — not the audit's generic Article
// example. Facts (free tier, contact limits) mirror the /pricing page.
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Larchsend",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  url: Astro.site?.href,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free plan: up to 1,000 contacts",
  },
};
// "<" must be escaped so a "</script>" in the payload can't end the block early.
const pageJsonLd = JSON.stringify(pageSchema).replace(/</g, "\\u003c");
---
<Base {title} {description}>
  <script type="application/ld+json" set:html={pageJsonLd} />
  <section class="hero">
    <h1>Email marketing that small businesses actually finish setting up</h1>
    <p>Larchsend gives small teams newsletters, welcome sequences and signup forms without an agency or a week of setup.</p>
    <img src="/hero.svg" />
  </section>
  <!-- Knownwise fix semantic.h1_count: one h1 per page states the topic; this
       section heading is a sublevel, so it demotes to h2. -->
  <h2>Why small teams pick Larchsend</h2>
  <ul>
    <li>Templates that look right on phones</li>
    <li>Automations you can read in plain English</li>
    <li>Pricing that starts free for your first 1,000 contacts</li>
  </ul>
</Base>
